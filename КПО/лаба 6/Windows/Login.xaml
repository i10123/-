<Window x:Class="Hospital.Windows.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Icon="logo.ico" Title="Авторизация" Height="Auto" Width="Auto" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        

    <Grid Margin="15">
        <materialDesign:Card Width="350" Padding="30" UniformCornerRadius="15" VerticalAlignment="Center">
            <StackPanel>
                <Button HorizontalAlignment="Right" Margin="-20,-20,-10,0" Style="{StaticResource MaterialDesignIconForegroundButton}" 
                        Click="CloseApp_Click" ToolTip="Закрыть">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                </Button>

                <materialDesign:PackIcon Kind="HospitalBuilding" Width="60" Height="60" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                <TextBlock Text="Больница" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="0,10,0,30" Foreground="Gray"/>

                <TextBox x:Name="LoginBox" materialDesign:HintAssist.Hint="Логин" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                         Margin="0,0,0,20" FontSize="14"/>

                <Grid Margin="0,0,0,40">
                    <Button x:Name="TogglePasswordButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Click="TogglePassword_Click" Margin="0,0,0,5" Panel.ZIndex="2" ToolTip="Показать пароль" Cursor="Hand">
                        <materialDesign:PackIcon x:Name="EyeIcon" Kind="Eye" Foreground="Gray"/>
                    </Button>

                    <PasswordBox x:Name="PasswordBoxHidden" materialDesign:HintAssist.Hint="Пароль" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                 FontSize="14" Padding="0,0,40,0" Visibility="Visible"/>

                    <TextBox x:Name="PasswordBoxVisible" materialDesign:HintAssist.Hint="Пароль" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             FontSize="14" Padding="0,0,40,0" Visibility="Hidden" BorderBrush="Transparent" Background="Transparent"/>
                </Grid>

                <Button Content="ВОЙТИ" Height="45" Click="LoginButton_Click" Style="{StaticResource MaterialDesignRaisedButton}" FontSize="18"/>

                <TextBlock x:Name="ErrorText" Text="" Foreground="#D32F2F" HorizontalAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>