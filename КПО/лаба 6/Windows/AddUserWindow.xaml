<Window x:Class="Hospital.Windows.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Добавление сотрудника" Height="600" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        Icon="logo.ico">

    <materialDesign:Card UniformCornerRadius="15" Margin="10" Padding="20">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Новый сотрудник" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <ComboBox x:Name="RoleCombo" materialDesign:HintAssist.Hint="Роль *" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,10" SelectionChanged="RoleCombo_SelectionChanged">
                <ComboBoxItem Content="Врач"/>
                <ComboBoxItem Content="Медсестра"/>
                <ComboBoxItem Content="Администратор"/>
            </ComboBox>

            <TextBox x:Name="LastNameBox" materialDesign:HintAssist.Hint="Фамилия *" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,5"/>
            <TextBox x:Name="FirstNameBox" materialDesign:HintAssist.Hint="Имя *" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,5"/>
            <TextBox x:Name="MiddleNameBox" materialDesign:HintAssist.Hint="Отчество" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,5"/>

            <TextBox x:Name="LoginBox" materialDesign:HintAssist.Hint="Логин *" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,5"/>
            <TextBox x:Name="PasswordBox" materialDesign:HintAssist.Hint="Пароль *" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,5"/>

            <StackPanel x:Name="SpecificFields" Visibility="Collapsed">
                <ComboBox x:Name="DepartmentCombo" materialDesign:HintAssist.Hint="Отделение *" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,10">
                    <ComboBoxItem Content="Приемное"/>
                    <ComboBoxItem Content="Кардиология"/>
                    <ComboBoxItem Content="Хирургия"/>
                    <ComboBoxItem Content="Неврология"/>
                </ComboBox>

                <CheckBox x:Name="DutyCheckBox" Content="Назначить дежурным (12ч)" Margin="0,10" Checked="DutyCheckBox_Changed" Unchecked="DutyCheckBox_Changed"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}" Click="Cancel_Click" HorizontalAlignment="Center" Width="140"/>

                <Button x:Name="SaveBtn" Content="СОХРАНИТЬ" Style="{StaticResource MaterialDesignRaisedButton}" Click="Save_Click" Margin="10,0,0,0" HorizontalAlignment="Center" Width="175"/>
            </StackPanel>
        </StackPanel>
    </materialDesign:Card>
</Window>