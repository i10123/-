<Window x:Class="Hospital.Windows.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Панель администратора" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" Icon="logo.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:ColorZone Mode="PrimaryMid" Padding="16">
            <DockPanel>
                <materialDesign:PackIcon Kind="Security" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Администратор: Центр управления" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                <Button DockPanel.Dock="Right" Content="ВЫЙТИ" Click="Logout_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Width="125" Margin="550,0,0,0"/>
            </DockPanel>
        </materialDesign:ColorZone>

        <TabControl Grid.Row="1" materialDesign:ColorZoneAssist.Mode="PrimaryMid" Style="{StaticResource MaterialDesignFilledTabControl}">

            <TabItem Header="ПЕРСОНАЛ">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Click="AddUser_Click" Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountPlus" Margin="0,0,8,0"/>
                                <TextBlock Text="ДОБАВИТЬ"/>
                            </StackPanel>
                        </Button>

                        <TextBox x:Name="StaffSearchBox" Width="300" Margin="20,0,0,0" materialDesign:HintAssist.Hint="Поиск"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" TextChanged="StaffSearchBox_TextChanged"/>
                    </StackPanel>

                    <DataGrid x:Name="StaffGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                              materialDesign:DataGridAssist.CellPadding="13,8,8,8" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding RoleRu}" Header="Роль" FontWeight="Bold"/>
                            <DataGridTextColumn Binding="{Binding FullName}" Header="ФИО" Width="200"/>
                            <DataGridTextColumn Binding="{Binding Login}" Header="Логин"/>

                            <DataGridTemplateColumn Header="Пароль" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton Cursor="Hand" ToolTip="Нажми, чтобы увидеть" Height="Auto" Padding="5">

                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent">
                                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>

                                            <Grid>
                                                <TextBlock Text="******" Foreground="Gray" FontSize="14" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding Password}" FontWeight="Bold" Foreground="Black" FontSize="14" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Binding="{Binding DepartmentRu}" Header="Отделение"/>

                            <DataGridCheckBoxColumn Binding="{Binding IsDuty}" Header="Дежурный" IsReadOnly="True"
                                            ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"/>

                            <DataGridTemplateColumn Header="Действия">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                                            Click="EditUser_Click" 
                                            ToolTip="Редактировать">
                                                <materialDesign:PackIcon Kind="Pencil"/>
                                            </Button>

                                            <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                                            Foreground="Red" 
                                            Click="DeleteUser_Click" 
                                            ToolTip="Удалить"
                                            Margin="10,0,0,0">
                                                <materialDesign:PackIcon Kind="Delete"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="ПАЦИЕНТЫ">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Click="AddPatient_Click" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountPlus" Margin="0,0,8,0"/>
                                <TextBlock Text="ДОБАВИТЬ"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <RadioButton Content="Сейчас в больнице" IsChecked="True" x:Name="RadioCurrent" Checked="PatientFilter_Changed" Margin="0,0,10,0"/>
                            <RadioButton Content="Выписанные" x:Name="RadioDischarged" Checked="PatientFilter_Changed"/>
                        </StackPanel>

                        <TextBox x:Name="PatientSearchBox" Width="300" Margin="40,0,0,0" materialDesign:HintAssist.Hint="Поиск"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" TextChanged="PatientSearchBox_TextChanged"/>
                    </StackPanel>

                    <DataGrid x:Name="PatientsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                              materialDesign:DataGridAssist.CellPadding="13,8,8,8" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding StatusRu}" Header="Статус" FontWeight="Bold"/>
                            <DataGridTextColumn Binding="{Binding FullName}" Header="ФИО" Width="200"/>
                            <DataGridTextColumn Binding="{Binding BirthDate, StringFormat=dd.MM.yyyy}" Header="Дата рожд."/>
                            <DataGridTextColumn Binding="{Binding PassportNumber}" Header="Паспорт"/>
                            <DataGridTextColumn Binding="{Binding Phone}" Header="Телефон"/>
                            <DataGridTextColumn Binding="{Binding Address}" Header="Адрес" Width="200"/>

                            <DataGridTextColumn Binding="{Binding MedicalRecord.AdmissionDate, StringFormat=dd.MM.yyyy HH:mm}" Header="Поступил"/>
                            <DataGridTextColumn Binding="{Binding DaysInHospital}" Header="Срок леч."/>

                            <DataGridTemplateColumn Header="Действия">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                    Click="EditPatient_Click" ToolTip="Редактировать данные">
                                                <materialDesign:PackIcon Kind="Pencil"/>
                                            </Button>
                                            
                                            <Button Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="Red" Click="DeletePatient_Click" ToolTip="Удалить запись" Margin="10,0,0,0">
                                                <materialDesign:PackIcon Kind="Delete"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>