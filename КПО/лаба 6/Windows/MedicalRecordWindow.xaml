<Window x:Class="Hospital.Windows.MedicalRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Электронная медицинская карта" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen" Icon="logo.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:ColorZone Mode="PrimaryDark" Padding="20">
            <DockPanel>
                <materialDesign:PackIcon Kind="Account" Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <StackPanel>
                    <TextBlock x:Name="PatientNameText" Text="Иванов Иван" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="PatientInfoText" Text="25 лет | Поступил..." Opacity="0.8"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="ЗАКРЫТЬ" IsCancel="True" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="200" HorizontalAlignment="Right"/>
            </DockPanel>
        </materialDesign:ColorZone>

        <TabControl x:Name="MainTabControl" Grid.Row="1" materialDesign:ColorZoneAssist.Mode="PrimaryMid" Style="{StaticResource MaterialDesignFilledTabControl}">

            <TabItem Header="ОСМОТР И ДВИЖЕНИЕ">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <materialDesign:Card Padding="15" Margin="0,0,0,15" UniformCornerRadius="8" Height="119">
                            <StackPanel>
                                <TextBlock Text="Диагноз" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBox x:Name="DiagnosisBox" 
                                         TextWrapping="Wrap" AcceptsReturn="True" Margin="0,5,0,0" FontSize="14"
                                         TextChanged="AutoSave_TextChanged" Height="69"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="15" UniformCornerRadius="8" Height="343">
                            <StackPanel>
                                <TextBlock Text="Анамнез" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBox x:Name="AnamnesisBox" 
                                         TextWrapping="Wrap" AcceptsReturn="True" Margin="0,5,0,0" Height="273" VerticalScrollBarVisibility="Auto"
                                         TextChanged="AutoSave_TextChanged"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <materialDesign:Card x:Name="DutyPanel" Padding="15" UniformCornerRadius="8" Margin="0,0,0,20" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Направление" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                <ComboBox x:Name="DepartmentCombo" materialDesign:HintAssist.Hint="Выберите отделение" 
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,20">
                                    <ComboBoxItem Content="Кардиология"/>
                                    <ComboBoxItem Content="Хирургия"/>
                                    <ComboBoxItem Content="Неврология"/>
                                </ComboBox>
                                <Button Content="НАПРАВИТЬ" Click="Transfer_Click"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{DynamicResource SecondaryHueMidBrush}"
                                        BorderBrush="{DynamicResource SecondaryHueMidBrush}"
                                        Foreground="{DynamicResource SecondaryHueMidForegroundBrush}"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card x:Name="AttendingPanel" Padding="15" UniformCornerRadius="8" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Выписка" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                <Button Content="СФОРМИРОВАТЬ ЭПИКРИЗ И ВЫПИСАТЬ" Background="Red" BorderBrush="Red" Click="Discharge_Click"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="15" Margin="0,20,0,0" Background="#E0E0E0">
                            <StackPanel>
                                <TextBlock Text="Статус" FontWeight="Bold"/>
                                <TextBlock x:Name="StatusText" Text="Поступил" Margin="0,5,0,0" FontSize="16"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="ЛИСТ НАЗНАЧЕНИЙ">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <materialDesign:Card Padding="15" Margin="0,0,0,20" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Новое назначение" FontWeight="Bold" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="TreatmentTypeCombo" Width="150" materialDesign:HintAssist.Hint="Тип" Margin="0,0,10,0" SelectionChanged="TreatmentType_Changed">
                                    <ComboBoxItem Content="Таблетки"/>
                                    <ComboBoxItem Content="Инъекции"/>
                                    <ComboBoxItem Content="Процедура"/>
                                    <ComboBoxItem Content="Диагностика"/>
                                </ComboBox>
                                <TextBox x:Name="TreatNameBox" Width="200" materialDesign:HintAssist.Hint="Название" Margin="0,0,10,0"/>
                                <StackPanel x:Name="MedFields" Orientation="Horizontal">
                                    <TextBox x:Name="TreatDosageBox" Width="100" materialDesign:HintAssist.Hint="Дозировка" Margin="0,0,10,0"/>
                                    <TextBox x:Name="TreatCountBox" Width="80" materialDesign:HintAssist.Hint="Кол-во" Margin="0,0,10,0"/>
                                </StackPanel>

                                <Button x:Name="AddTreatBtn" Content="ДОБАВИТЬ" Style="{StaticResource MaterialDesignOutlinedButton}" Click="AddTreatment_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <DataGrid x:Name="TreatmentsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                              materialDesign:DataGridAssist.CellPadding="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding DatePrescribed, StringFormat=dd.MM HH:mm}" Header="Дата" FontWeight="Bold"/>
                            <DataGridTextColumn Binding="{Binding InfoText}" Header="Назначение" Width="*"/>
                            <DataGridTextColumn Binding="{Binding DoctorName}" Header="Врач (назначил)" Width="150"/>

                            <DataGridTemplateColumn Header="Выполнено" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Click="TreatmentStatus_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Binding="{Binding ExecutionResult}" Header="Отметка о выполнении" Width="250" Foreground="Gray" FontSize="11"/>

                            <DataGridTemplateColumn x:Name="ActionsColumn" Header="Действия" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Button Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                    Click="EditTreatment_Click" ToolTip="Изменить">
                                                <materialDesign:PackIcon Kind="Pencil"/>
                                            </Button>

                                            <Button Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="Red" Click="DeleteTreatment_Click" ToolTip="Удалить">
                                                <materialDesign:PackIcon Kind="Delete"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>